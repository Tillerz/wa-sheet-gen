<div class='container-fluid block-test-sheet'>
  <div class='row'>
    <div class='col-12 col-md-6'>
      <div class='card personal f-1'>
        <div class='card-header f-2'>Personal</div>
        <div class='card-body'>
          <table class='table'>
            <tr>
              <th>
                <label class='ilbl ilbl-name' for='name'>name</label>
              </th>
              <td>
                <div class='ivar ivar-name'><input value='{{variables.name|default}}' class='form-control ivar ivar-name' id='name' name='name' type='text' required='required' /></div>
              </td>
            </tr>
            <tr>
              <th>
                <label class='ilbl ilbl-level' for='level'>Level</label>
              </th>
              <td>
                <div class='ivar ivar-level'><input value='{{variables.level|default}}' class='form-control ivar ivar-level' id='level' name='level' type='number' min='1' max='20' placeholder='1-20' /></div>
              </td>
            </tr>
            <tr>
              <th><span class='f-3'>plain</span></th>
              <td></td>
              <td>
                <div class='ivar ivar-note'><input value='{{variables.note|default}}' class='form-control ivar ivar-note' id='note' name='note' type='text' /></div>
              </td>
            </tr>
          </table>
        </div>
      </div>
    </div>
    <div class='col-lg-4'>
      <img src='/i/7978043/render' alt='' width='350'>
      <div class='txt'>Tom&#39;s &lt;b&gt;&#123;&#123; variables.x &#125;&#125;&lt;/b&gt; &amp; &quot;more&quot;</div>
      <div class='ilbl ilbl-notes'><label for='notes'>Notes</label></div>
      <div class='ivar ivar-notes'><textarea class='form-control ivar ivar-notes' id='notes' name='notes' rows='5' placeholder='Write it&#39;s notes'>{{variables.notes|default}}</textarea></div>
      <div class='ilbl ilbl-wounds-001'><label for='wounds_001'>wound</label></div>
      <div class='ivar ivar-wounds-001'><input value='0' name='wounds_001' type='hidden' /><input value='1' {% if variables.wounds_001|default > 0 %}checked='checked'{% endif %} class='ivar ivar-wounds-001' id='wounds_001' name='wounds_001' type='checkbox' /></div>
      <div class='ilbl ilbl-weapon-range'><label for='weapon_range'>range</label></div>
      <div class='ivar ivar-weapon-range'><select class='form-control ivar ivar-weapon-range' id='weapon_range' name='weapon_range'><option value='Melee' {% if variables.weapon_range|default == 'Melee' %}selected='selected'{% endif %}>Melee</option><option value='Very Close' {% if variables.weapon_range|default == 'Very Close' %}selected='selected'{% endif %}>Very Close</option><option value='It&#39;s far' {% if variables.weapon_range|default == 'It\'s far' %}selected='selected'{% endif %}>It&#39;s far</option></select></div>
      <div class='ilbl ilbl-ancestry'><label for='ancestry'>ancestry</label></div>
      <div class='ivar ivar-ancestry'><input value='{{variables.ancestry|default}}' list='list-ancestry' class='form-control ivar ivar-ancestry' id='ancestry' name='ancestry' type='text' /><datalist id='list-ancestry'><option value='Elf'></option><option value='Dwarf'></option></datalist></div>
      <div class='ilbl ilbl-portrait'><label for='portrait'>portrait</label></div>
      <div class='ivar ivar-portrait'><input value='{{variables.portrait|default}}' class='form-control ivar ivar-portrait' id='portrait' name='portrait' type='number' placeholder='WA Image ID' /></div>
    </div>
    <div class='col'>
      <ul class='f-4'>
        <li class='f-5'><span class='f-3'>Item</span></li>
        <li>
          <div class='ilbl ilbl-gear'><label for='gear'>gear</label></div>
          <div class='ivar ivar-gear'><input value='{{variables.gear|default}}' class='form-control ivar ivar-gear' id='gear' name='gear' type='text' /></div>
        </li>
      </ul>
      <ol class='f-6'>
        <li>First</li>
      </ol>
      <table class='table'>
        <tr>
          <th>Skill</th>
          <th>Rank</th>
        </tr>
        {% for i in 1..3 %}
          {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
          <tr>
            <th>
              <label class='ilbl ilbl-skill' for='skill_{{id}}'>skill</label>
            </th>
            <td>
              <div class='ivar ivar-skill'><input value='{{attribute(variables, 'skill_' ~ id)|default}}' class='form-control ivar ivar-skill' id='skill_{{id}}' name='skill_{{id}}' type='number' /></div>
            </td>
          </tr>
        {% endfor %}
      </table>
      <table class='table'>
        <tr>
          <th>
            <label class='ilbl ilbl-weapon'>Weapon</label>
          </th>
          <th>Damage</th>
        </tr>
        {% for i in 1..2 %}
          {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
          <tr>
            <td>
              <div class='ivar ivar-weapon'><input value='{{attribute(variables, 'weapon_' ~ id)|default}}' class='form-control ivar ivar-weapon' id='weapon_{{id}}' name='weapon_{{id}}' type='text' /></div>
            </td>
            <td>
              <div class='ivar ivar-damage'><input value='{{attribute(variables, 'damage_' ~ id)|default}}' class='form-control ivar ivar-damage' id='damage_{{id}}' name='damage_{{id}}' type='text' /></div>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% for i in 1..2 %}
      {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
      <div class='col-12 col-lg-6'>
        <div class='card'>
          <div class='card-body'>
            <div class='ilbl ilbl-wound'><label for='wound_{{id}}'>wound</label></div>
            <div class='ivar ivar-wound'><input value='0' name='wound_{{id}}' type='hidden' /><input value='1' {% if attribute(variables, 'wound_' ~ id)|default > 0 %}checked='checked'{% endif %} class='ivar ivar-wound' id='wound_{{id}}' name='wound_{{id}}' type='checkbox' /></div>
            <div class='ilbl ilbl-trait'><label for='trait_{{id}}'>trait</label></div>
            <div class='ivar ivar-trait'><input value='{{attribute(variables, 'trait_' ~ id)|default}}' list='list-trait-{{id}}' class='form-control ivar ivar-trait' id='trait_{{id}}' name='trait_{{id}}' type='text' /><datalist id='list-trait-{{id}}'><option value='Brave'></option><option value='Sly'></option></datalist></div>
            <div class='ilbl ilbl-size'><label for='size_{{id}}'>size</label></div>
            <div class='ivar ivar-size'><select class='form-control ivar ivar-size' id='size_{{id}}' name='size_{{id}}'><option value='1H' {% if attribute(variables, 'size_' ~ id)|default == '1H' %}selected='selected'{% endif %}>1H</option><option value='2H' {% if attribute(variables, 'size_' ~ id)|default == '2H' %}selected='selected'{% endif %}>2H</option></select></div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
